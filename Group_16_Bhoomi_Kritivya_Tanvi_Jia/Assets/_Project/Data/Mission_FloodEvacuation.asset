%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a86b52515103a44048cbd7497208e4d1, type: 3}
  m_Name: Mission_FloodEvacuation
  m_EditorClassIdentifier: RescueSim.Runtime::RescueSim.Core.MissionDefinition
  missionId: flash-flood-evacuation
  title: Flash Flood Evacuation
  tagline: Floodwater has filled a residential street. Two neighbours need help.
  briefing: 'Floodwater has entered a residential street. The water is knee-deep
    and rising: you only need to walk, never swim.


    1. Wade into the street
    and grab the orange RESCUE BUOY with GRIP.

    2. Follow the blue arrows along
    the evacuation route.

    3. Find both civilians on the porches.

    4. Hold
    GRIP on each person to check them, keep holding to lift them.

    5. Carry each
    one up the ramp to the raised SAFE ZONE and release GRIP there.


    There is
    no timer pressure: follow the glowing markers.'
  stageIndex: 2
  sceneName: FloodEvacuation
  cardBlurb: Wade along the marked route, grab the rescue buoy and escort two civilians
    to higher ground.
  accent: {r: 0.25, g: 0.7, b: 1, a: 1}
  usesExposure: 0
  timeLimitSeconds: 900
  exposureRecoveryPerSecond: 0.1
  objectives:
  - id: enter
    title: Enter the flooded street
    hint: Wade forward from the staging area.
    required: 1
  - id: equip
    title: Grab the rescue buoy
    hint: It is on the post by the start.
    required: 1
  - id: safe-route
    title: Follow the evacuation route
    hint: Follow the blue arrows.
    required: 1
  - id: locate
    title: Find both civilians
    hint: Check the porches.
    required: 1
  - id: evacuate
    title: Carry them to the safe zone
    hint: Keep GRIP held. Release it inside the raised zone.
    required: 1
  scoring:
    survivorPoints: 500
    hazardPoints: 300
    timeBonusPoints: 200
    maxExposurePenalty: 150
    mistakePenalty: 25
    maxScore: 1000
