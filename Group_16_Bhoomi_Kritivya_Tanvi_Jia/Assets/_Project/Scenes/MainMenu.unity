  m_Name:
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>POINT + TRIGGER</b>  presses menu buttons.

    <b>GRIP</b>  grabs
    objects (extinguisher, debris, buoy) and works the breaker. Hold GRIP on a person
    to lift and carry them (release GRIP in the green zone to deliver); hold GRIP
    on a valve to turn it.

    <b>TRIGGER</b>  while holding the extinguisher sprays
    it.

    <b>LEFT STICK</b> walk.   <b>RIGHT STICK</b> turn.

    <b>PUSH STICK
    FORWARD AND RELEASE</b> to teleport.

    <b>MENU BUTTON</b> (left controller)
    pauses.

    <b>RAISE YOUR LEFT WRIST</b> to read your checklist.


    Follow
    the glowing markers and floor arrows. Nothing here needs fast reflexes or swimming.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
